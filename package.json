{
  "name": "picture-book",
  "version": "0.1.0",
  "description": "Turn stories into editable, illustrated books. Free and open source.",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Ammann",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --configLoader native --host 127.0.0.1 --port 5173",
    "build": "node node_modules/vite/bin/vite.js build --configLoader native && node scripts/build-worker.mjs",
    "preview": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:pack": "node scripts/package-desktop.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "fflate": "0.7.4",
    "idb-keyval": "6.3.0",
    "pdf-lib": "1.17.1",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "5.6.205",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.4.1",
    "esbuild": "0.28.0",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "org.agammann.picturebook",
    "productName": "Picture Book",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Picture-Book-${version}-${arch}.${ext}"
  }
}
